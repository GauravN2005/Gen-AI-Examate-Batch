# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt streamlit

COPY app ./app
COPY ui ./ui
COPY data/records.json ./data/records.json

EXPOSE 8501

CMD ["sh", "-c", "streamlit run ui/app.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --server.headless true"]
